{
  "expo": {
    "name": "Tamagit",
    "slug": "tamagit",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "tamagit",
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0f0f0f"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-asset"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juanf24steam.tamagit"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.juanf24steam.tamagit"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "115c76ee-2d9f-404d-aa4c-0f63accac48e"
      }
    },
    "owner": "juanf24s-team"
  }
}
